# ============================================================
# Environment Variables - MYPERPUS Auth Module (SQLite)
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database SQLite ---
# Lokasi file database (opsional, default: data/myperpus.sqlite)
DB_PATH=data/myperpus.sqlite

# --- JWT (JSON Web Token) ---
# Secret key untuk sign dan verifikasi token (gunakan random string panjang di produksi)
JWT_SECRET=super_secret_jwt_key_myperpus_2026_keamanan_terjamin
JWT_EXPIRES_IN=24h

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Seed Admin Pertama (Opsional) ---
# Jika diset dan belum ada akun admin di database, sistem akan membuat
# akun admin secara otomatis saat server dijalankan.
ADMIN_EMAIL=admin@myperpus.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
