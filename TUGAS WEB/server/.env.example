# ============================================================
# Environment Variables - MYPERPUS Auth Module (SQLite)
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database SQLite ---
# Lokasi file database (opsional, default: data/myperpus.sqlite)
# Tidak perlu setting username, password, atau port database!
DB_PATH=data/myperpus.sqlite

# --- JWT (JSON Web Token) ---
# Secret key untuk sign dan verifikasi token
JWT_SECRET=super_secret_jwt_key_myperpus_2026_keamanan_terjamin
JWT_EXPIRES_IN=24h

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
