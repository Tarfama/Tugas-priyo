# ============================================================
# Environment Variables - COPY file ini menjadi .env
# cp .env.example .env  (lalu isi value-nya)
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=myperpus_db

# --- JWT (JSON Web Token) ---
# Buat secret yang kuat, minimal 32 karakter random
# Bisa generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_yang_sangat_kuat_dan_panjang
JWT_EXPIRES_IN=24h

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
